{
  "name": "discord-oynuyor-studio",
  "version": "1.0.0",
  "description": "Discord Rich Presence durumunu kolayca düzenleyen Windows uygulaması",
  "main": "src/main.js",
  "author": "Hasan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hasan.discordoynuyor",
    "productName": "Discord Oynuyor Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Discord-Oynuyor-Studio-${version}.exe"
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  }
}
